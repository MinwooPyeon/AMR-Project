# Copy this file to .env and fill in the values
# Usage: export $(cat .env | xargs) before running the system

# MQTT Broker
MQTT_BROKER=192.168.100.141
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Local MQTT Broker (for AI communication)
MQTT_LOCAL_BROKER=localhost
MQTT_LOCAL_PORT=1883

# System
SYSTEM_NAME=AMR001
DEBUG_MODE=false

# User authentication (SHA-256 hash of the password)
# To generate: python3 -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
AMR_USER_ADMIN=
AMR_USER_OPERATOR=
